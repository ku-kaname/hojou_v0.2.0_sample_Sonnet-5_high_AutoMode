backend/**/__pycache__/
backend/**/*.pyc
backend/.venv/
backend/**/*.db
backend/**/.pytest_cache/

# Node（frontend）
frontend/node_modules/
frontend/dist/
frontend/**/*.tsbuildinfo

# OS
.DS_Store
